<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:elevation="2dp"
    android:radius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Status Dot -->
        <View
            android:id="@+id/vStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#4CAF50"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCurrCourseCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT 101"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCurrCourseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing"
                android:textSize="13sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvCurrCoursePrereq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prerequisite: None"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSED"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/badge_passed" />

    </LinearLayout>
</androidx.cardview.widget.CardView>